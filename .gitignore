# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Claude Code user settings
.claude/

# Project-scoped DeepSeek Harness state and credentials
.dsh/

# OS files
.DS_Store
**/.DS_Store

# Logs
*.log
logs/

# Next.js web viewer
web/node_modules/
web/.next/
web/.env.local
web/.env.dev
web/.env.prod
evals/.env
civbench_sas_token.txt
notebooks/.env

# Paper (LaTeX source, figures, build artifacts — kept locally).
# The scenario spec is a tracked deliverable; excluding the directory itself
# would stop git from descending into it, so exclude its contents and
# re-include that one file.
docs/paper/*
!docs/paper/scenario-spec.md

# Save files
/saves/

# Lean-vs-legacy experiment artifacts: baseline manifests, run logs, and
# copies of the user's saves. Per-run evidence, never source; the manifest
# schema is documented in docs/experiment-baseline.md.
experiments/

# CivBench eval artifacts.
# Benchmark saves under evals/saves/ are tracked fixtures, so no pattern here
# may cover them. (A previous line read
# `evals/saves/*.Civ6Save  # benchmark saves are tracked`; gitignore has no
# trailing comments, so the whole line became a literal pattern that matched
# nothing.)
evals/.resume_context.md
eval-logs/
.vercel
scripts/mission_control.sh
docs/agent-essays/*
!docs/agent-essays/the-hallucination-of-competence.md
mission-control/
docs/analysis/

# Mutation testing (tool.mutmut)
mutants/
.mutmut-cache

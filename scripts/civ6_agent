#!/usr/bin/env bash
# Run a bounded, Civ-only DSH agent session without the DSH Web UI.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
turns=1
dry_run=0
with_coding=0
play_profile="${CIV_MCP_PLAY_PROFILE:-legacy}"

usage() {
  printf '%s\n' \
    'Usage: ./scripts/civ6_agent [--turns N] [--play-profile legacy|lean] [--with-coding] [--dry-run]' \
    '' \
    'Starts Civilization VI recovery when needed, then lets the Civ-only agent' \
    'complete exactly N full turns (default: 1).' \
    '' \
    'Play profiles (CIV_MCP_PLAY_PROFILE):' \
    '  legacy (default)  Belief Engine modes, governance gates, full tool surface.' \
    '  lean              governance off, no control-plane tools, short role prompt.' \
    '                    Rejected when CIV_MCP_BELIEF_MODE is explicitly' \
    '                    observe/enforce, instead of silently overriding it.'
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --turns)
      if [ "$#" -lt 2 ]; then
        printf 'ERROR: --turns requires a positive integer.\n' >&2
        exit 2
      fi
      turns="$2"
      shift 2
      ;;
    --play-profile)
      if [ "$#" -lt 2 ]; then
        printf 'ERROR: --play-profile requires legacy or lean.\n' >&2
        exit 2
      fi
      play_profile="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --with-coding)
      with_coding=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'ERROR: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! [[ "$turns" =~ ^[1-9][0-9]*$ ]]; then
  printf 'ERROR: --turns must be a positive integer, got: %s\n' "$turns" >&2
  exit 2
fi

case "$play_profile" in
  legacy|lean) ;;
  *)
    printf 'ERROR: --play-profile must be legacy or lean, got: %s\n' "$play_profile" >&2
    exit 2
    ;;
esac

# A contradictory configuration must fail here, before anything starts, rather
# than being resolved by whichever side happens to read the environment last.
# The MCP child enforces the same rule, so a hand-set environment cannot slip
# past this wrapper either.
normalized_belief_mode="$(printf '%s' "${CIV_MCP_BELIEF_MODE:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
if [ "$play_profile" = "lean" ] && [ -n "$normalized_belief_mode" ] && [ "$normalized_belief_mode" != "off" ]; then
  printf 'ERROR: --play-profile lean 与 CIV_MCP_BELIEF_MODE=%s 冲突。\n' \
    "$CIV_MCP_BELIEF_MODE" >&2
  printf '精简游玩要求治理关闭；请改用 --play-profile legacy，或取消 CIV_MCP_BELIEF_MODE 设置。\n' >&2
  exit 2
fi

task="请启动并执行文明 VI 智能体回合循环。完整完成恰好 ${turns} 个回合，不多不少。\
如果游戏尚未进入对局，等待 civ6-mcp 的受控恢复流程启动并载入最近恢复存档。\
每回合必须遵循系统提示中的查询、蛮族优先、执行、核验和结束回合顺序。\
记录开始时与每次 end_turn 后确认的回合号；遇到治理门禁、需人类决策、游戏结束或连接异常立即停止，\
并在最终中文报告中说明已实际完成的回合数与原因。"

# Report the *effective* configuration, not the requested one. This asks the
# same resolution code the MCP child runs, so a dry run cannot promise a profile
# or tool surface the child would not actually serve.
profile_report() {
  ( cd "$script_dir/.." && CIV_MCP_PLAY_PROFILE="$play_profile" \
      uv run python -c 'from civ_mcp.server.assembly import play_profile_summary; print(play_profile_summary())' )
}

if [ "$dry_run" -eq 1 ]; then
  printf 'Civ agent dry run: turns=%s, play_profile=%s, auto_recovery=1, web_ui=disabled, coding_module=%s\n' \
    "$turns" "$play_profile" "$with_coding"
  printf 'Task: %s\n' "$task"
  printf 'Host tool deadline: %s ms (civ6.cordis.yml)\n' \
    "$(sed -n 's/^[[:space:]]*toolCallTimeoutMs:[[:space:]]*\([0-9]*\)[[:space:]]*$/\1/p' \
      "$script_dir/../integrations/deepseek-harness/civ6.cordis.yml" | head -1)"
  if ! profile_report; then
    printf 'ERROR: 无法解析 play profile 配置（见上方错误）。\n' >&2
    exit 1
  fi
  exit 0
fi

# The MCP child reads this at startup. The wrapper leaves all process and
# FireTuner single-client checks to scripts/deepseek_harness.
exec env CIV_MCP_DSH_AUTO_RESUME=1 CIV6_DSH_ENABLE_CODING="$with_coding" \
  CIV_MCP_PLAY_PROFILE="$play_profile" \
  "$script_dir/deepseek_harness" civ6-agent "$task"

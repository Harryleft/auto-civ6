    {
      "id": "MECHANIC_VICTORY_DOMINATION",
      "names": {
        "zh_Hans_CN": "征服胜利与原始首都",
        "en_US": "Domination victory and original capitals"
      },
      "summary": "征服目标是原始首都控制权，失去自己的原始首都会影响此路径。",
      "conditions": [
        "概念正文要求控制所有文明的原始首都；现首都、迁都后首都与原始首都应区分。",

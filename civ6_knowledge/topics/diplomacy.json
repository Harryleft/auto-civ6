    {
      "id": "MECHANIC_DIPLOMACY_DEALS",
      "names": {
        "zh_Hans_CN": "双边交易、条款与接受",
        "en_US": "Bilateral deals, terms and acceptance"
      },
      "summary": "双边交易交换双方可提供的条目；报价、AI 接受和实际成交是不同步骤，不会因建立商路自动成交。",
      "conditions": [
        "必须分清我方付出、对方付出、一次性转移与持续条款；数量、期限和资源类型逐项确认。",
        "对方库存与可交易候选会改变，静态规则无法确定接受价格或代替当前报价。",
        "赠礼是单向转移，不能因没有对价就推断可以撤回；接受后仍需回读余额、资源和协议。",
        "开放边界等协议有独立行动前置，列入交易不绕过资格条件。"
      ],
      "source_selectors": [

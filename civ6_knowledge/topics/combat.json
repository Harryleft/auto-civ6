    {
      "id": "MECHANIC_COMBAT_CONTROL_ZONE",
      "names": {
        "zh_Hans_CN": "控制区与寻路",
        "en_US": "Zone of control and pathfinding"
      },
      "summary": "ZoneOfControl 标记单位是否施加控制区；当前路线受哪些敌军控制须结合地图判断。",
      "conditions": [
        "区分施加控制区与忽略敌方控制区的能力；单位类别、陆海关系及河流可能形成例外。",
        "不能凭基础移动力或直线格数断言可绕过敌军；先查实际可达性。"
      ],

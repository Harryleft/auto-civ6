    {
      "id": "MECHANIC_RESOURCES_SEA_LEVEL",
      "names": {
        "zh_Hans_CN": "海平面与气候阶段",
        "en_US": "Sea level and climate stages"
      },
      "summary": "海平面事件含气候阶段、冰层损失和肥力变化标记；不同阶段的条件不能用同一灾害概率概括。",
      "conditions": [
        "EffectOperatorType 为 SEA_LEVEL 的事件与普通洪水分开；中后期的 HaltsFloodFertility、HaltsStormFertility、FertilityRemovalChance 需逐阶段核对。",
        "CLIMATE_CHANGE_PERCENT_COASTAL_LOWLANDS 是全局生成参数，不能推导某个已生成地块的低地等级或淹没状态。",
        "当前阶段、低地等级及已淹没／沉没地块必须读取本局地图，不能从静态事件 Severity 推断损失。"
      ],
      "source_selectors": [
